{
  "version": 1,
  "about": "The superloops wizard: the questions a person answers before the first /superloops, and which loop types each answer brings in. `loops` are added to the project's plan; `suggest` are listed for later, to build when a failure shows that the project needs them. `wizard.py check` validates this file against the catalog; `wizard.py resolve` turns a set of answers into a profile and a plan.",
  "core": {
    "prompt": "steps/wizard-core.md",
    "loops": [
      "build",
      "lint-with-fix-instructions",
      "red-green-tdd",
      "stop-hook",
      "autoformat-hook",
      "secret-scanning",
      "dependency-scanning-sbom",
      "bug-failing-test-fix",
      "stall-detector",
      "risky-action-gates",
      "plan-approval",
      "correction-becomes-rule"
    ]
  },
  "bundles": [
    {
      "id": "verify",
      "type": "build",
      "title": "verify: build, types, lint and tests in one command, before every stop and in CI",
      "covers": [
        "build",
        "type-check",
        "lint-with-fix-instructions",
        "red-green-tdd",
        "stop-hook"
      ],
      "why": "One command over the project's build, type check, lint and tests, run by the Stop hook before the agent ends its turn and by CI where the agent cannot change it. One loop, not five: the harness's rule \"The cheapest form that catches the failure\"."
    }
  ],
  "order": [
    "verify",
    "risky-action-gates",
    "autoformat-hook",
    "secret-scanning",
    "e2e-browser",
    "agentic-manual-testing",
    "scripted-model-tests",
    "llm-evals",
    "integration-tests-emulators",
    "run-tests-first",
    "ci-clean-infra",
    "pre-commit-pre-push",
    "stall-detector",
    "plan-approval",
    "dependency-scanning-sbom",
    "bug-failing-test-fix",
    "reproduction-gate",
    "taste-invariants",
    "sast",
    "dependency-updates",
    "benchmarks-vs-baseline",
    "db-migration-lint",
    "api-breaking-changes",
    "approved-fixtures",
    "config-validation",
    "i18n-pseudolocalization",
    "health-checks-smoke",
    "error-tracking",
    "release-confirmation",
    "human-diff-review",
    "verification-subagent",
    "agent-code-review",
    "progress-file-feature-list",
    "agent-ci-hardening",
    "triage",
    "correction-becomes-rule"
  ],
