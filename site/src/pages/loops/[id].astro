---
// A loop type's page: what its card holds (SITE-1#1, #2), each field of the LoopType read model a data-field.
import Page from '../../layouts/Page.astro';
import { getCatalog } from '../../lib/site.mjs';

export function getStaticPaths() {
  return getCatalog().loopTypes.map((card) => ({ params: { id: card.id }, props: { card } }));
}

const { card } = Astro.props;
const lists = [
  ['Places', 'places', card.places],
  ['Stages', 'stages', card.stages],
  ['Qualities', 'qualities', card.qualities],
].filter(([, , values]) => values.length > 0);
---

<Page title={`${card.title.text} · superloops`}>
  <h1 data-field="title" set:html={card.title.html} />
  <dl>
    <dt>Group</dt>
    <dd data-field="group">{card.group}</dd>
    {
      lists.map(([label, field, values]) => (
        <>
          <dt>{label}</dt>
          <dd data-field={field}>{values.join(', ')}</dd>
        </>
      ))
    }
    <dt>Summary</dt>
    <dd data-field="summary" set:html={card.summary} />
  </dl>
  <div data-field="sections" set:html={card.sections} />
</Page>
